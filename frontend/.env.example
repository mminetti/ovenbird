# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Session encryption key — must be at least 32 characters, keep secret
NUXT_SESSION_PASSWORD=

# Auth0 OAuth credentials — see docs/auth0-setup.md.
# Domain and Audience must match the backend's Auth0:Domain / Auth0:Audience
# (backend/src/Web, via `dotnet user-secrets`) so the access token this app
# requests is accepted by the API.
NUXT_OAUTH_AUTH0_CLIENT_ID=
NUXT_OAUTH_AUTH0_CLIENT_SECRET=
NUXT_OAUTH_AUTH0_DOMAIN=
NUXT_OAUTH_AUTH0_AUDIENCE=

# .NET backend base URL (no trailing slash)
NUXT_PUBLIC_BACKEND_URL=https://localhost:57679
